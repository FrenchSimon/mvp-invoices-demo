# Copier dans .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings > API). Ne jamais committer .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Envoi des factures par email (Resend > API Keys, accès « Sending access »).
# Côté serveur uniquement : pas de préfixe NEXT_PUBLIC_.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend. Vide : onboarding@resend.dev,
# qui n'envoie qu'à l'adresse du compte Resend (démo).
RESEND_FROM_EMAIL=

# Clé secrète Supabase (Project Settings > API Keys > Secret keys, sb_secret_...).
# Serveur uniquement : sert au webhook Stripe pour changer le plan d'un compte.
SUPABASE_SECRET_KEY=

# Stripe en mode test (Developers > API keys > Secret key, sk_test_...).
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...), donné par Stripe à la création
# du point de terminaison https://<site>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
