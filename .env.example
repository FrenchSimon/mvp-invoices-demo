# Copier dans .env.local et remplir avec les valeurs du projet Supabase
# (Project Settings > API). Ne jamais committer .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Envoi des factures par email (Resend > API Keys, accès « Sending access »).
# Côté serveur uniquement : pas de préfixe NEXT_PUBLIC_.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend. Vide : onboarding@resend.dev,
# qui n'envoie qu'à l'adresse du compte Resend (démo).
RESEND_FROM_EMAIL=
